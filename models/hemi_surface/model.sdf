<?xml version="1.0"?>
<sdf version="1.8">
  <model name="hemi_surface">
    <static>true</static>

    <!-- Keep the model centered at its local origin; launch files place it in world. -->
    <pose>0 0 0 0 0 0</pose>

    <link name="link">
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>meshes/hemisphere_r100_centered_meters.stl</uri>
          </mesh>
        </geometry>
      </visual>

      <collision name="collision">
        <geometry>
          <mesh>
            <uri>meshes/hemisphere_r100_centered_meters.stl</uri>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
